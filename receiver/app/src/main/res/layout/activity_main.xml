<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0A0E1A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📺 Screen Mirror Receiver"
        android:textColor="#6C9EFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#6C9EFF"
        android:textSize="18sp"
        android:layout_gravity="center"
        android:layout_marginBottom="12dp"
        android:lineSpacingExtra="4dp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏹️ Parado"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp" />

    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:text="📡 Aguardar"
            android:textSize="16sp"
            android:background="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:text="⏹️ Parar"
            android:textSize="16sp"
            android:background="#F44336"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1. Toque em Aguardar\n2. Digite o IP acima no celular\n3. Inicie a transmissão no celular"
        android:textColor="#888888"
        android:textSize="13sp"
        android:layout_gravity="center"
        android:gravity="center" />

</LinearLayout>
