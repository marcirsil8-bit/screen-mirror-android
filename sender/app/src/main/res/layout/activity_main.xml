<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#0A0E1A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📱 Screen Mirror Sender"
        android:textColor="#6C9EFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏹️ Parado"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#888888"
        android:textSize="14sp"
        android:layout_marginBottom="20dp"
        android:lineSpacingExtra="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IP da TV Box:"
        android:textColor="#AAAAAA"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etIp"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:hint="ex: 192.168.1.100"
        android:textColor="#FFFFFF"
        android:textColorHint="#555555"
        android:textSize="18sp"
        android:inputType="text"
        android:background="#1A1E2E"
        android:padding="12dp"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:text="📡 Iniciar Transmissão"
        android:textSize="16sp"
        android:background="#4CAF50"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:text="⏹️ Parar"
        android:textSize="16sp"
        android:background="#F44336"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="O TV Box e o celular devem estar\nna mesma rede WiFi"
        android:textColor="#555555"
        android:textSize="13sp"
        android:layout_marginTop="24dp"
        android:gravity="center" />

</LinearLayout>
